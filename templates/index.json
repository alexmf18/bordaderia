      "settings": {
        "custom_liquid": "{%- comment -%}\n  ============================================================\n  BORDADERÍA · Banner marquesina (texto en movimiento)\n  Pegar en: Personalizar tema → Añadir sección → Liquid personalizado\n  Edita los mensajes en la variable \"mensajes\" (separados por |).\n  El resto se ajusta en las variables CSS del bloque <style>.\n  ============================================================\n{%- endcomment -%}\n\n{%- assign mensajes = 'Diseños exclusivos|Bordados personalizados|Envíos a todo el país|Calidad premium' | split: '|' -%}\n\n{%- capture grupo -%}\n  {%- for mensaje in mensajes -%}\n    <span class=\"brd-mq__item\">{{ mensaje | strip }}</span>\n    <span class=\"brd-mq__sep\" aria-hidden=\"true\">&middot;</span>\n  {%- endfor -%}\n{%- endcapture -%}\n\n<div class=\"brd-mq\" role=\"marquee\" aria-label=\"Ventajas de comprar en Bordadería\">\n  <div class=\"brd-mq__track\">\n    <div class=\"brd-mq__grupo\">{{ grupo }}</div>\n    <div class=\"brd-mq__grupo\" aria-hidden=\"true\">{{ grupo }}</div>\n  </div>\n</div>\n\n<style>\n  /* --- quita el espacio que el tema añade alrededor de la sección --- */\n  .shopify-section:has(.brd-mq) {\n    padding-top: 0 !important;\n    padding-bottom: 0 !important;\n    margin-top: 0 !important;\n    margin-bottom: 0 !important;\n  }\n  .shopify-section:has(.brd-mq) > *:not(.brd-mq) {\n    padding-top: 0 !important;\n    padding-bottom: 0 !important;\n    margin-top: 0 !important;\n    margin-bottom: 0 !important;\n  }\n\n  .brd-mq {\n    /* ---------- ajustes rápidos ---------- */\n    --mq-fondo: #EFEDED;        /* fondo azul muy oscuro */\n    --mq-color: #6C63E8;        /* color del texto */\n    --mq-sep-color: #6C63E8;    /* color de los puntos separadores */\n    --mq-alto: 46px;\n    --mq-fuente: 12px;\n    --mq-tracking: 0.16em;\n    --mq-velocidad: 34s;        /* más segundos = más lento */\n    --mq-espacio: 26px;         /* separación entre palabras y puntos */\n    /* ------------------------------------- */\n\n    box-sizing: border-box;\n    position: relative;\n    display: flex;\n    align-items: center;\n    overflow: hidden;\n\n    /* ancho completo aunque el tema envuelva la sección */\n    width: 100vw;\n    max-width: 100vw;\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n\n    min-height: var(--mq-alto);\n    background-color: var(--mq-fondo);\n    user-select: none;\n  }\n\n  .brd-mq__track {\n    display: flex;\n    width: max-content;\n    will-change: transform;\n    animation: brd-mq-scroll var(--mq-velocidad) linear infinite;\n  }\n\n  .brd-mq:hover .brd-mq__track {\n    animation-play-state: paused;\n  }\n\n  .brd-mq__grupo {\n    display: flex;\n    align-items: center;\n    flex: 0 0 auto;\n  }\n\n  .brd-mq__item,\n  .brd-mq__sep {\n    font-family: inherit;\n    font-size: var(--mq-fuente);\n    font-weight: 500;\n    line-height: 1;\n    letter-spacing: var(--mq-tracking);\n    text-transform: uppercase;\n    white-space: nowrap;\n    padding: 0 calc(var(--mq-espacio) / 2);\n  }\n\n  .brd-mq__item { color: var(--mq-color); }\n  .brd-mq__sep  { color: var(--mq-sep-color); }\n\n  @keyframes brd-mq-scroll {\n    from { transform: translate3d(0, 0, 0); }\n    to   { transform: translate3d(-50%, 0, 0); }\n  }\n\n  @media screen and (max-width: 749px) {\n    .brd-mq {\n      --mq-alto: 40px;\n      --mq-fuente: 11px;\n      --mq-tracking: 0.12em;\n      --mq-espacio: 20px;\n      --mq-velocidad: 24s;\n    }\n  }\n\n  /* accesibilidad: sin movimiento para quien lo tenga desactivado */\n  @media (prefers-reduced-motion: reduce) {\n    .brd-mq { overflow-x: auto; }\n    .brd-mq__track { animation: none; }\n  }\n</style>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
