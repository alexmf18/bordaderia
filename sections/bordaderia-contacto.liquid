{%- comment -%}
  ============================================================
  BORDADERÍA · Contacto
  Izquierda: título, texto breve y tarjetas de contacto.
  Derecha: formulario que llega al correo de la tienda.
  ============================================================
{%- endcomment -%}

{%- liquid
  assign col_texto = section.settings.text_width
  assign col_form = 100 | minus: col_texto
  assign id_form = 'brd-ct-' | append: section.id
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --brd-ct-bg: {{ section.settings.bg_color }};
    --brd-ct-heading: {{ section.settings.heading_color }};
    --brd-ct-text: {{ section.settings.text_color }};
    --brd-ct-label: {{ section.settings.label_color }};
    --brd-ct-border: {{ section.settings.border_color }};
    --brd-ct-box-bg: {{ section.settings.box_bg }};
    --brd-ct-form-bg: {{ section.settings.form_bg }};
    --brd-ct-field-bg: {{ section.settings.field_bg }};
    --brd-ct-btn: {{ section.settings.button_bg }};
    --brd-ct-btn-text: {{ section.settings.button_text_color }};
    --brd-ct-icon: {{ section.settings.icon_color }};
    --brd-ct-gap: {{ section.settings.gap }}px;
    --brd-ct-max: {{ section.settings.max_width }}px;
    --brd-ct-col-txt: {{ col_texto }}fr;
    --brd-ct-col-form: {{ col_form }}fr;
    --brd-ct-heading-size: {{ section.settings.heading_size }}px;
    --brd-ct-text-size: {{ section.settings.text_size }}px;
    --brd-ct-radius: {{ section.settings.box_radius }}px;
    --brd-ct-border-w: {{ section.settings.border_width }}px;
    --brd-ct-box-pad: {{ section.settings.box_padding }}px;
    --brd-ct-form-pad: {{ section.settings.form_padding }}px;
    --brd-ct-form-radius: {{ section.settings.form_radius }}px;
    --brd-ct-form-heading: {{ section.settings.form_heading_color }};
    --brd-ct-form-heading-size: {{ section.settings.form_heading_size }}px;
    --brd-ct-form-label: {{ section.settings.form_label_color }};
    --brd-ct-field-text: {{ section.settings.field_text_color }};
    --brd-ct-field-radius: {{ section.settings.field_radius }}px;
    --brd-ct-field-py: {{ section.settings.field_padding_y }}px;
    --brd-ct-field-border-w: {{ section.settings.field_border_width }}px;
  }

  .brd-ct {
    box-sizing: border-box;
    background: var(--brd-ct-bg);
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .brd-ct {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="brd-ct">
  <div class="brd-ct__inner page-width">
    <div class="brd-ct__layout brd-ct__layout--{{ section.settings.form_position }}">

      {%- comment -%} ---------- columna de texto ---------- {%- endcomment -%}
      <div class="brd-ct__col-texto">
        {%- if section.settings.label != blank -%}
          <p class="brd-ct__label">{{ section.settings.label | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="brd-ct__heading">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="brd-ct__caja">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="brd-ct__contactos" role="list">
            {%- for block in section.blocks -%}
              {%- liquid
                case block.settings.icon
                  when 'telefono'
                    assign ruta_icono = 'M6.6 2.5 8.9 7 7.3 8.6a11.5 11.5 0 0 0 5.1 5.1L14 12.1l4.5 2.3v3.1c0 1-.8 1.8-1.8 1.6C8.7 18.2 2.8 12.3 2 4.3c-.1-1 .7-1.8 1.6-1.8h3Z'
                  when 'email'
                    assign ruta_icono = 'M3 5.5h15v10H3zM3 6l7.5 5.5L18 6'
                  when 'instagram'
                    assign ruta_icono = 'M4 4h13v13H4zM10.5 7.8a2.7 2.7 0 1 0 0 5.4 2.7 2.7 0 0 0 0-5.4M14 6.6h.01'
                  when 'whatsapp'
                    assign ruta_icono = 'M3.5 17.5 4.7 14a6.7 6.7 0 1 1 2.6 2.5l-3.8 1M8 8.3c.4 1.6 1.8 3 3.4 3.4'
                  when 'ubicacion'
                    assign ruta_icono = 'M10.5 18s5.5-4.6 5.5-9a5.5 5.5 0 1 0-11 0c0 4.4 5.5 9 5.5 9ZM10.5 7.2a2 2 0 1 0 0 4 2 2 0 0 0 0-4'
                  when 'horario'
                    assign ruta_icono = 'M10.5 3a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15M10.5 6.5v4.3l3 1.7'
                  else
                    assign ruta_icono = 'M10.5 3a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15M10.5 7v4M10.5 14h.01'
                endcase
              -%}
              <li class="brd-ct__contacto" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a class="brd-ct__contacto-caja" href="{{ block.settings.link }}"
                    {% if block.settings.new_tab %}target="_blank" rel="noopener"{% endif %}>
                {%- else -%}
                  <div class="brd-ct__contacto-caja">
                {%- endif -%}

                {%- if section.settings.show_icons -%}
                  <svg class="brd-ct__icono" viewBox="0 0 21 21" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="{{ ruta_icono }}"/>
                  </svg>
                {%- endif -%}

                <span class="brd-ct__contacto-texto">
                  {%- if block.settings.label != blank -%}
                    <span class="brd-ct__contacto-label">{{ block.settings.label | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.value != blank -%}
                    <span class="brd-ct__contacto-valor">{{ block.settings.value | escape }}</span>
                  {%- endif -%}
                </span>

                {%- if block.settings.link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- formulario ---------- {%- endcomment -%}
      <div class="brd-ct__col-form">
        <div class="brd-ct__form-caja">
          {%- if section.settings.form_heading != blank -%}
            <h2 class="brd-ct__form-heading">{{ section.settings.form_heading | escape }}</h2>
          {%- endif -%}

          {%- form 'contact', id: id_form, class: 'brd-ct__form' -%}
            {%- if form.posted_successfully? -%}
              <p class="brd-ct__ok" role="status">{{ section.settings.success_text | escape }}</p>
            {%- elsif form.errors -%}
              <div class="brd-ct__error" role="alert">
                <p>{{ section.settings.error_text | escape }}</p>
                <ul role="list">
                  {%- for campo in form.errors -%}
                    <li>{{ form.errors.messages[campo] }}</li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            <div class="brd-ct__campos">
              <p class="brd-ct__campo">
                <label for="{{ id_form }}-nombre">{{ section.settings.name_label | escape }}</label>
                <input
                  type="text"
                  id="{{ id_form }}-nombre"
                  name="contact[{{ 'templates.contact.form.name' | t }}]"
                  autocomplete="name"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  {% if section.settings.name_required %}required{% endif %}
                >
              </p>

              <p class="brd-ct__campo">
                <label for="{{ id_form }}-email">{{ section.settings.email_label | escape }}</label>
                <input
                  type="email"
                  id="{{ id_form }}-email"
                  name="contact[email]"
                  autocomplete="email"
                  spellcheck="false"
                  autocapitalize="off"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  required
                >
              </p>

              {%- if section.settings.show_phone -%}
                <p class="brd-ct__campo">
                  <label for="{{ id_form }}-tel">{{ section.settings.phone_label | escape }}</label>
                  <input
                    type="tel"
                    id="{{ id_form }}-tel"
                    name="contact[{{ 'templates.contact.form.phone' | t }}]"
                    autocomplete="tel"
                    value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  >
                </p>
              {%- endif -%}

              {%- if section.settings.show_subject -%}
                <p class="brd-ct__campo">
                  <label for="{{ id_form }}-asunto">{{ section.settings.subject_label | escape }}</label>
                  {%- assign asuntos = section.settings.subject_options | split: ',' -%}
                  <select id="{{ id_form }}-asunto" name="contact[Asunto]">
                    {%- for opcion in asuntos -%}
                      <option value="{{ opcion | strip | escape }}">{{ opcion | strip | escape }}</option>
                    {%- endfor -%}
                  </select>
                </p>
              {%- endif -%}

              <p class="brd-ct__campo brd-ct__campo--ancho">
                <label for="{{ id_form }}-mensaje">{{ section.settings.message_label | escape }}</label>
                <textarea
                  id="{{ id_form }}-mensaje"
                  name="contact[{{ 'templates.contact.form.comment' | t }}]"
                  rows="{{ section.settings.message_rows }}"
                  required
                >{{ form.body }}</textarea>
              </p>

              {%- if section.settings.show_consent -%}
                <p class="brd-ct__consent brd-ct__campo--ancho">
                  <input type="checkbox" id="{{ id_form }}-consent" name="contact[Consentimiento]" value="Sí" required>
                  <label for="{{ id_form }}-consent">{{ section.settings.consent_text }}</label>
                </p>
              {%- endif -%}
            </div>

            <button type="submit" class="brd-ct__submit">
              <span>{{ section.settings.button_label | escape }}</span>
              {%- if section.settings.button_arrow -%}
                <span aria-hidden="true">&rarr;</span>
              {%- endif -%}
            </button>

            {%- if section.settings.form_note != blank -%}
              <p class="brd-ct__nota">{{ section.settings.form_note | escape }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .brd-ct,
  #shopify-section-{{ section.id }} .brd-ct *,
  #shopify-section-{{ section.id }} .brd-ct *::before,
  #shopify-section-{{ section.id }} .brd-ct *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .brd-ct__inner {
    max-width: var(--brd-ct-max);
    margin-left: auto;
    margin-right: auto;
  }

  #shopify-section-{{ section.id }} .brd-ct__layout {
    display: grid;
    grid-template-columns: var(--brd-ct-col-txt) var(--brd-ct-col-form);
    gap: var(--brd-ct-gap);
    align-items: {{ section.settings.vertical_align }};
  }

  #shopify-section-{{ section.id }} .brd-ct__layout--left {
    grid-template-columns: var(--brd-ct-col-form) var(--brd-ct-col-txt);
  }

  #shopify-section-{{ section.id }} .brd-ct__layout--left .brd-ct__col-form {
    order: -1;
  }

  #shopify-section-{{ section.id }} .brd-ct__col-texto,
  #shopify-section-{{ section.id }} .brd-ct__col-form {
    min-width: 0;
  }

  /* ---------- columna de texto ---------- */

  #shopify-section-{{ section.id }} .brd-ct__label {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brd-ct-label);
  }

  #shopify-section-{{ section.id }} .brd-ct__heading {
    margin: 0;
    font-size: var(--brd-ct-heading-size);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--brd-ct-heading);
  }

  #shopify-section-{{ section.id }} .brd-ct__caja {
    margin-top: 20px;
    padding: var(--brd-ct-box-pad);
    background: var(--brd-ct-box-bg);
    border: var(--brd-ct-border-w) solid var(--brd-ct-border);
    border-radius: var(--brd-ct-radius);
    font-size: var(--brd-ct-text-size);
    line-height: 1.75;
    color: var(--brd-ct-text);
  }

  #shopify-section-{{ section.id }} .brd-ct__caja > *:first-child { margin-top: 0; }
  #shopify-section-{{ section.id }} .brd-ct__caja > *:last-child { margin-bottom: 0; }

  #shopify-section-{{ section.id }} .brd-ct__contactos {
    display: grid;
    grid-template-columns: repeat({{ section.settings.contact_columns }}, minmax(0, 1fr));
    gap: 12px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .brd-ct__contacto {
    min-width: 0;
    display: flex;
  }

  #shopify-section-{{ section.id }} .brd-ct__contacto-caja {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 12px 14px;
    background: var(--brd-ct-box-bg);
    border: var(--brd-ct-border-w) solid var(--brd-ct-border);
    border-radius: var(--brd-ct-radius);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} a.brd-ct__contacto-caja:hover,
  #shopify-section-{{ section.id }} a.brd-ct__contacto-caja:focus-visible {
    border-color: var(--brd-ct-btn);
    transform: translateY(-2px);
  }

  #shopify-section-{{ section.id }} .brd-ct__icono {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    flex: 0 0 auto;
    color: var(--brd-ct-icon);
  }

  #shopify-section-{{ section.id }} .brd-ct__contacto-texto {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .brd-ct__contacto-label {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brd-ct-label);
  }

  #shopify-section-{{ section.id }} .brd-ct__contacto-valor {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--brd-ct-heading);
    overflow-wrap: anywhere;
  }

  /* ---------- formulario ---------- */

  #shopify-section-{{ section.id }} .brd-ct__form-caja {
    padding: var(--brd-ct-form-pad);
    background: var(--brd-ct-form-bg);
    border: {% if section.settings.form_border %}var(--brd-ct-border-w){% else %}0{% endif %} solid var(--brd-ct-border);
    border-radius: var(--brd-ct-form-radius);
  }

  #shopify-section-{{ section.id }} .brd-ct__form-heading {
    margin: 0 0 26px;
    font-size: var(--brd-ct-form-heading-size);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--brd-ct-form-heading);
  }

  #shopify-section-{{ section.id }} .brd-ct__campos {
    display: grid;
    grid-template-columns: repeat({{ section.settings.form_columns }}, minmax(0, 1fr));
    gap: {{ section.settings.field_gap }}px;
  }

  #shopify-section-{{ section.id }} .brd-ct__campo,
  #shopify-section-{{ section.id }} .brd-ct__consent {
    margin: 0;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .brd-ct__campo--ancho,
  #shopify-section-{{ section.id }} .brd-ct__consent {
    grid-column: 1 / -1;
  }

  #shopify-section-{{ section.id }} .brd-ct__campo label {
    display: block;
    margin-bottom: 8px;
    font-size: {{ section.settings.field_label_size }}px;
    font-weight: 500;
    {%- if section.settings.field_label_style == 'uppercase' %}
    letter-spacing: 0.14em;
    text-transform: uppercase;
    {%- else %}
    letter-spacing: 0.01em;
    {%- endif %}
    color: var(--brd-ct-form-label);
  }

  #shopify-section-{{ section.id }} .brd-ct__campo input,
  #shopify-section-{{ section.id }} .brd-ct__campo select,
  #shopify-section-{{ section.id }} .brd-ct__campo textarea {
    width: 100%;
    padding: var(--brd-ct-field-py) 18px;
    background: var(--brd-ct-field-bg);
    border: var(--brd-ct-field-border-w) solid var(--brd-ct-border);
    border-radius: var(--brd-ct-field-radius);
    font-family: inherit;
    font-size: {{ section.settings.field_font_size }}px;
    line-height: 1.5;
    color: var(--brd-ct-field-text);
  }

  #shopify-section-{{ section.id }} .brd-ct__campo textarea {
    resize: vertical;
    /* el área de mensaje no se convierte en cápsula por muy alto que sea el radio */
    border-radius: min(var(--brd-ct-field-radius), 22px);
  }

  #shopify-section-{{ section.id }} .brd-ct__campo input:focus,
  #shopify-section-{{ section.id }} .brd-ct__campo select:focus,
  #shopify-section-{{ section.id }} .brd-ct__campo textarea:focus {
    outline: 2px solid var(--brd-ct-btn);
    outline-offset: 1px;
    border-color: var(--brd-ct-btn);
  }

  #shopify-section-{{ section.id }} .brd-ct__consent {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 11px;
    line-height: 1.5;
    color: var(--brd-ct-text);
  }

  #shopify-section-{{ section.id }} .brd-ct__consent label {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0;
    text-transform: none;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .brd-ct__consent input {
    margin-top: 2px;
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .brd-ct__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: {% if section.settings.button_full %}100%{% else %}auto{% endif %};
    margin-top: 22px;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    border: 1px solid var(--brd-ct-btn);
    border-radius: {{ section.settings.button_radius }}px;
    background: var(--brd-ct-btn);
    color: var(--brd-ct-btn-text);
    font-family: inherit;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_weight }};
    {%- if section.settings.button_uppercase %}
    letter-spacing: 0.14em;
    text-transform: uppercase;
    {%- else %}
    letter-spacing: 0.02em;
    {%- endif %}
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .brd-ct__submit:hover {
    opacity: 0.88;
  }

  #shopify-section-{{ section.id }} .brd-ct__nota {
    margin: 12px 0 0;
    font-size: 11px;
    line-height: 1.5;
    color: var(--brd-ct-label);
  }

  #shopify-section-{{ section.id }} .brd-ct__ok,
  #shopify-section-{{ section.id }} .brd-ct__error {
    margin: 0 0 16px;
    padding: 12px 14px;
    border-radius: {{ section.settings.field_radius }}px;
    font-size: 12px;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .brd-ct__ok {
    border: 1px solid #1E8E3E;
    color: #1E8E3E;
  }

  #shopify-section-{{ section.id }} .brd-ct__error {
    border: 1px solid #D93025;
    color: #D93025;
  }

  #shopify-section-{{ section.id }} .brd-ct__error ul {
    margin: 6px 0 0;
    padding-left: 18px;
  }

  /* ---------- responsive ---------- */

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .brd-ct__contactos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .brd-ct__layout,
    #shopify-section-{{ section.id }} .brd-ct__layout--left {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    #shopify-section-{{ section.id }} .brd-ct__layout--left .brd-ct__col-form {
      order: 0;
    }

    #shopify-section-{{ section.id }} .brd-ct__contactos {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .brd-ct__campos {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .brd-ct__submit {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .brd-ct__contacto-caja,
    #shopify-section-{{ section.id }} .brd-ct__submit {
      transition: none;
    }

    #shopify-section-{{ section.id }} a.brd-ct__contacto-caja:hover {
      transform: none;
    }
  }
</style>

{% schema %}
{
  "name": "Contacto",
  "tag": "section",
  "class": "brd-ct-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Etiqueta superior",
      "info": "Opcional."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Contáctanos"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto breve",
      "default": "<p>¿Tienes una idea para un bordado personalizado o una duda sobre tu pedido? Escríbenos y te respondemos en menos de 24 horas laborables.</p>"
    },
    {
      "type": "header",
      "content": "Tarjetas de contacto"
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Mostrar iconos",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Tamaño de los iconos",
      "default": 18
    },
    {
      "type": "range",
      "id": "contact_columns",
      "min": 1,
