{%- comment -%}
  ============================================================
  BORDADERÍA · Panel técnico
  Bloque con fondo propio: a un lado un titular a dos líneas
  y un texto; al otro, una imagen de detalle del bordado.
  ============================================================
{%- endcomment -%}

{%- liquid
  assign imagen = section.settings.image
  if imagen == blank and section.settings.use_product_image
    assign imagen = product.images[1] | default: product.featured_image
  endif

  assign partes = section.settings.image_ratio | split: '/'
  assign ratio_w = partes[0] | plus: 0.0
  assign ratio_h = partes[1] | plus: 0.0
  if ratio_w <= 0 or ratio_h <= 0
    assign ratio_w = 1.0
    assign ratio_h = 1.0
  endif
  assign ratio_pct = ratio_h | times: 100.0 | divided_by: ratio_w

  assign col_img = section.settings.image_width
  assign col_txt = 100 | minus: col_img
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --brd-pt-page-bg: {{ section.settings.page_bg }};
    --brd-pt-panel-bg: {{ section.settings.panel_bg }};
    --brd-pt-border: {{ section.settings.border_color }};
    --brd-pt-line1: {{ section.settings.line1_color }};
    --brd-pt-line2: {{ section.settings.line2_color }};
    --brd-pt-text: {{ section.settings.text_color }};
    --brd-pt-media-bg: {{ section.settings.media_bg }};
    --brd-pt-pad: {{ ratio_pct }}%;
    --brd-pt-gap: {{ section.settings.gap }}px;
    --brd-pt-panel-pad: {{ section.settings.panel_padding }}px;
    --brd-pt-max: {{ section.settings.max_width }}px;
    --brd-pt-col-img: {{ col_img }}fr;
    --brd-pt-col-txt: {{ col_txt }}fr;
    --brd-pt-heading-size: {{ section.settings.heading_size }}px;
    --brd-pt-text-size: {{ section.settings.text_size }}px;
  }

  .brd-pt {
    box-sizing: border-box;
    background: var(--brd-pt-page-bg);
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .brd-pt {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="brd-pt">
  <div class="brd-pt__inner page-width">
    <div class="brd-pt__panel brd-pt__panel--{{ section.settings.layout }}">
      <div class="brd-pt__text-col">
        {%- if section.settings.line1 != blank or section.settings.line2 != blank -%}
          <h2 class="brd-pt__heading">
            {%- if section.settings.line1 != blank -%}
              <span class="brd-pt__line brd-pt__line--1">{{ section.settings.line1 | escape }}</span>
            {%- endif -%}
            {%- if section.settings.line2 != blank -%}
              <span class="brd-pt__line brd-pt__line--2">{{ section.settings.line2 | escape }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="brd-pt__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="brd-pt__btn" href="{{ section.settings.button_link }}">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>

      <div class="brd-pt__media-col">
        <div class="brd-pt__media">
          {%- if imagen != blank -%}
            <img
              class="brd-pt__img"
              src="{{ imagen | image_url: width: 1200 }}"
              srcset="
                {{ imagen | image_url: width: 600 }} 600w,
                {{ imagen | image_url: width: 900 }} 900w,
                {{ imagen | image_url: width: 1200 }} 1200w
              "
              sizes="(min-width: 750px) {{ col_img }}vw, 92vw"
              alt="{{ imagen.alt | escape }}"
              width="{{ imagen.width }}"
              height="{{ imagen.height }}"
              loading="lazy"
            >
          {%- else -%}
            {{ 'detailed-apparel-1' | placeholder_svg_tag: 'brd-pt__placeholder' }}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .brd-pt,
  #shopify-section-{{ section.id }} .brd-pt *,
  #shopify-section-{{ section.id }} .brd-pt *::before,
  #shopify-section-{{ section.id }} .brd-pt *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .brd-pt__inner {
    max-width: var(--brd-pt-max);
    margin-left: auto;
    margin-right: auto;
  }

  #shopify-section-{{ section.id }} .brd-pt__panel {
    display: grid;
    grid-template-columns: var(--brd-pt-col-txt) var(--brd-pt-col-img);
    gap: var(--brd-pt-gap);
    align-items: center;
    padding: var(--brd-pt-panel-pad);
    background: var(--brd-pt-panel-bg);
    border: {{ section.settings.border_width }}px solid var(--brd-pt-border);
    border-radius: {{ section.settings.panel_radius }}px;
  }

  #shopify-section-{{ section.id }} .brd-pt__panel--left {
    grid-template-columns: var(--brd-pt-col-img) var(--brd-pt-col-txt);
  }

  #shopify-section-{{ section.id }} .brd-pt__panel--left .brd-pt__media-col {
    order: -1;
  }

  #shopify-section-{{ section.id }} .brd-pt__text-col,
  #shopify-section-{{ section.id }} .brd-pt__media-col {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .brd-pt__heading {
    margin: 0;
    font-size: var(--brd-pt-heading-size);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  #shopify-section-{{ section.id }} .brd-pt__line {
    display: block;
  }

  #shopify-section-{{ section.id }} .brd-pt__line--1 { color: var(--brd-pt-line1); }
  #shopify-section-{{ section.id }} .brd-pt__line--2 { color: var(--brd-pt-line2); }

  #shopify-section-{{ section.id }} .brd-pt__text {
    max-width: 52ch;
    margin-top: 16px;
    font-size: var(--brd-pt-text-size);
    line-height: 1.8;
    color: var(--brd-pt-text);
  }

  #shopify-section-{{ section.id }} .brd-pt__text > *:first-child { margin-top: 0; }
  #shopify-section-{{ section.id }} .brd-pt__text > *:last-child { margin-bottom: 0; }

  #shopify-section-{{ section.id }} .brd-pt__btn {
    display: inline-block;
    margin-top: 22px;
    padding: 12px 26px;
    border: 1px solid var(--brd-pt-line2);
    border-radius: 2px;
    color: var(--brd-pt-line2);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  #shopify-section-{{ section.id }} .brd-pt__btn:hover {
    background: var(--brd-pt-line2);
    color: var(--brd-pt-panel-bg);
  }

  #shopify-section-{{ section.id }} .brd-pt__media {
    position: relative;
    width: 100%;
    height: 0;
    padding-top: var(--brd-pt-pad);
    overflow: hidden;
    background: var(--brd-pt-media-bg);
    border-radius: {{ section.settings.image_radius }}px;
  }

  #shopify-section-{{ section.id }} .brd-pt__img,
  #shopify-section-{{ section.id }} .brd-pt__placeholder {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    max-width: none;
    min-height: 0;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    object-fit: cover;
    object-position: center center;
  }

  #shopify-section-{{ section.id }} .brd-pt__placeholder {
    fill: #C9C9C9;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .brd-pt__panel,
    #shopify-section-{{ section.id }} .brd-pt__panel--left {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: calc(var(--brd-pt-panel-pad) * 0.7);
    }

    #shopify-section-{{ section.id }} .brd-pt__panel--left .brd-pt__media-col {
      order: 0;
    }

    #shopify-section-{{ section.id }} .brd-pt__heading {
      font-size: calc(var(--brd-pt-heading-size) * 0.85);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .brd-pt__btn {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "Panel técnico",
  "tag": "section",
  "class": "brd-pt-section",
  "settings": [
    {
      "type": "text",
      "id": "line1",
      "label": "Titular · primera línea",
      "default": "Precisión Digital."
    },
    {
      "type": "text",
      "id": "line2",
      "label": "Titular · segunda línea",
      "default": "Textura Analógica."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Nuestra técnica de bordado fusiona el diseño generado por ordenador con maquinaria industrial calibrada al milímetro. Cada hilo se traza meticulosamente para asegurar líneas nítidas y una densidad perfecta, dando como resultado un grafismo que no solo se ve, sino que se siente. El contraste entre el algodón y el relieve estructurado del hilo crea una estética minimalista y contundente.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "info": "Opcional."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "checkbox",
      "id": "use_product_image",
      "label": "Si no hay imagen, usar una del producto",
      "info": "Toma la segunda foto del producto, o la principal si solo hay una.",
      "default": true
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Posición de la imagen",
      "options": [
        { "value": "right", "label": "Derecha" },
        { "value": "left", "label": "Izquierda" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 30,
      "max": 65,
      "step": 5,
      "unit": "%",
      "label": "Ancho de la imagen",
      "default": 45
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la imagen",
      "options": [
        { "value": "1/1", "label": "Cuadrada (1:1)" },
        { "value": "4/3", "label": "Horizontal (4:3)" },
        { "value": "3/2", "label": "Horizontal (3:2)" },
        { "value": "4/5", "label": "Vertical (4:5)" }
      ],
      "default": "1/1"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Redondeo de la imagen",
      "default": 0
    },
    {
      "type": "header",
      "content": "Panel"
    },
    {
      "type": "range",
      "id": "panel_padding",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Relleno interior",
      "default": 40
    },
    {
      "type": "range",
      "id": "panel_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Redondeo del panel",
      "default": 2
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 3,
      "step": 1,
      "unit": "px",
      "label": "Grosor del borde",
      "default": 1
    },
    {
      "type": "range",
      "id": "gap",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Separación entre texto e imagen",
      "default": 48
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 900,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Ancho del contenido",
      "default": 1240
    },
    {
      "type": "header",
      "content": "Tamaños"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del titular",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del texto",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "page_bg",
      "label": "Fondo de la sección",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "panel_bg",
      "label": "Fondo del panel",
      "default": "#F7F6F4"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borde del panel",
      "default": "#E5E3DF"
    },
    {
      "type": "color",
      "id": "media_bg",
      "label": "Fondo de la imagen",
      "default": "#EDEDED"
    },
    {
      "type": "color",
      "id": "line1_color",
      "label": "Titular · primera línea",
      "default": "#1B2A63"
    },
    {
      "type": "color",
      "id": "line2_color",
      "label": "Titular · segunda línea",
      "default": "#1A4EE0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#5A5A57"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacio superior",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espacio inferior",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Panel técnico"
    }
  ]
}
{% endschema %}
